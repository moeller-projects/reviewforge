@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ReviewForge.Service.Components.Dashboard
@using static ReviewForge.Service.Components.Dashboard.DashboardPresentation
@inject DashboardBrowserClient Browser
@inject TimeProvider Clock
@implements IAsyncDisposable
<PageTitle>ReviewForge dashboard</PageTitle>
<main class="dashboard technician-dashboard" aria-busy="@_Loading.ToString().ToLowerInvariant()">
    <span class="sr-only" role="status" aria-live="polite">@_Announcement</span>
    <header class="dashboard-header">
        <div><p class="eyebrow">REVIEWFORGE</p><h1>Runs needing attention</h1></div>
        <div class="dashboard-actions">
            <a class="dashboard-start" href="/dashboard/start">Start draft review</a>
            <RadzenButton Text="Refresh" Icon="refresh" Click="RequestRefreshAsync" Disabled="@(_Loading || _AuthExpired)" aria-label="Refresh dashboard" />
            <form method="post" action="/dashboard/logout"><AntiforgeryToken /><RadzenButton Text="Log out" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Light" /></form>
        </div>
    </header>
    <section class="worklist-toolbar" aria-label="Filter runs">
        <label>Search<input type="search" value="@_Search" @oninput="SearchChanged" placeholder="Title, PR ID, repository or project" aria-label="Search runs" /></label>
        <div class="worklist-view" aria-label="Run view">
            <button type="button" aria-pressed="@_AttentionOnly.ToString().ToLowerInvariant()" aria-label="Show runs needing attention" @onclick="() => SetViewAsync(true)">Needs attention</button>
            <button type="button" aria-pressed="@((!_AttentionOnly).ToString().ToLowerInvariant())" aria-label="Show all recent runs" @onclick="() => SetViewAsync(false)">All recent</button>
        </div>
    </section>
    @if (_Error is not null)
    {
        <div class="notice error" role="alert">@_Error
            @if (_Data is not null) { <span>Showing previous snapshot; data may be stale. Last successful update @Time(_LastSuccess).</span> }
            @if (_AuthExpired) { <a href="/dashboard/login">Log in again</a> }
        </div>
    }
    @if (_Data is { } data)
    {
        <div class="worklist-status">
            <span>@_Items.Count loaded runs · @_Items.Count(i => i.NeedsAttention) need attention</span>
            <span>Updated @Time(_LastSuccess)</span>
        </div>
        @if (_RetainedHistory)
        {
            <p class="notice retained-history-warning" role="status">Some loaded runs were outside the refreshed window; their last observed snapshot is retained and may be stale.</p>
        }
        <RunWorklist Items="Filtered" AttentionOnly="_AttentionOnly" Now="data.GeneratedAt" />
        @if (Filtered.Count == 0 && _Items.Count > 0 && !string.IsNullOrWhiteSpace(_Search))
        {
            <p role="status">No matching runs in loaded history. Try another search or load more.</p>
        }
        <div class="worklist-paging">
            @if (_HasMore && _PageCount < MaxPages && _Items.Count < MaxItems)
            {
                <button type="button" aria-label="Load more runs" @onclick="LoadMoreAsync" disabled="@(_Loading || _AuthExpired)">Load more runs</button>
            }
            <span>Search applies to loaded history. Changing view starts a new bounded window. Up to @MaxItems runs per view.</span>
        </div>
        <details class="worklist-metadata">
            <summary>Snapshot and source information@((data.InventoryStale || !data.InventoryComplete || data.SourceWarnings.Count > 0) ? " · warnings" : "")</summary>
            <p>Revisions are ordered by newest observed run, not provider revision numbers. Older revisions stay collapsed unless they need attention.</p>
            <p>History is a bounded snapshot, not a full archive. Refresh re-reads loaded pages; previously loaded rows displaced by newer runs are retained until this page is reopened. Counts above describe loaded runs only. Closed or unavailable PRs remain accessible by identity.</p>
            @if (_Items.Count >= MaxItems || _PageCount >= MaxPages) { <p>History limit reached. Reopen this page for the newest window; use run links for older details.</p> }
            <p>Source inventory @Time(data.InventoryFetchedAt). Unknown finding and decision counts are not treated as zero. Legacy and gate-skipped history may be unavailable after restart.</p>
            @if (data.InventoryStale) { <p>Source inventory is stale; current-head metadata may be outdated.</p> }
            @if (!data.InventoryComplete) { <p>Partial inventory — metadata is missing for some PRs; run history is independent of open-PR inventory.</p> }
            @foreach (var warning in data.SourceWarnings) { <p>@warning</p> }
        </details>
    }
    else if (_Loading) { <p role="status" class="empty">Loading runs…</p> }
</main>

@code {
    private const int PageSize = 50, MaxPages = 10, MaxItems = PageSize * MaxPages;
    private RunWorklistResponse? _Data;
    private IReadOnlyList<RunWorklistItem> _Items = [];
    private DashboardRefreshLoop? _Refresh;
    private bool _Loading = true, _Disposed, _AuthExpired, _AttentionOnly = true, _HasMore, _RetainedHistory;
    private int _PageCount = 1, _RequestedPages = 1, _ViewGeneration;
    private bool _ReplaceHistoryOnLoad;
    private string _Search = "", _Announcement = "";
    private string? _Error;
    private DateTimeOffset _LastSuccess;
    private IReadOnlyList<RunWorklistItem> Filtered => string.IsNullOrWhiteSpace(_Search) ? _Items : _Items.Where(i =>
        Contains(i.Title) || Contains(i.Pr.PrId.ToString(System.Globalization.CultureInfo.InvariantCulture)) ||
        Contains(i.RepositoryName) || Contains(i.Pr.RepositoryId) || Contains(i.Pr.Project) || Contains(i.Pr.Org)).ToArray();
    private bool Contains(string? value) => value?.Contains(_Search.Trim(), StringComparison.OrdinalIgnoreCase) == true;
    private void SearchChanged(ChangeEventArgs args) => _Search = args.Value?.ToString() ?? "";
    private bool IsActive() => _Items.Any(i => i.Run.State is RunState.Queued or RunState.Running || i.Run.IsPending || i.Run.IsClaimed);
    private Task RequestRefreshAsync() => _Refresh?.RequestAsync() ?? Task.CompletedTask;
    private Task SetViewAsync(bool attentionOnly)
    {
        if (_AttentionOnly == attentionOnly || _AuthExpired) return Task.CompletedTask;
        _AttentionOnly = attentionOnly;
        _ViewGeneration++;
        _PageCount = _RequestedPages = 1;
        _ReplaceHistoryOnLoad = true;
        _HasMore = false;
        return RequestRefreshAsync();
    }
    private Task LoadMoreAsync()
    {
        if (_Loading || _AuthExpired || !_HasMore || _PageCount >= MaxPages || _Items.Count >= MaxItems) return Task.CompletedTask;
        _RequestedPages = _PageCount + 1;
        return RequestRefreshAsync();
    }

    // No prerender HTTP: only the interactive authenticated browser may make requests.
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_Disposed)
        {
            _Refresh = new(Clock, IsActive, ct => InvokeAsync(() => LoadAsync(ct)));
            _Refresh.Start();
        }
        return Task.CompletedTask;
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        if (_Disposed || _AuthExpired) return;
        _Loading = true;
        StateHasChanged();
        var viewGeneration = _ViewGeneration;
        var attentionOnly = _AttentionOnly;
        var fresh = new Dictionary<Guid, RunWorklistItem>();
        RunWorklistResponse? latest = null;
        var warnings = new HashSet<string>(StringComparer.Ordinal);
        var requested = Math.Min(MaxPages, _RequestedPages);
        var pages = 0;
        for (var page = 0; page < requested; page++)
        {
            var result = await Browser.GetRunWorklistAsync(page * PageSize, PageSize, attentionOnly: attentionOnly, ct: ct);
            if (_Disposed || ct.IsCancellationRequested || viewGeneration != _ViewGeneration) return;
            if (result.Outcome != BrowserOutcome.Ok || result.Value is not { } value)
            {
                _RequestedPages = _PageCount;
                _Loading = false;
                _AuthExpired = result.Outcome is BrowserOutcome.Unauthenticated or BrowserOutcome.Forbidden;
                if (_AuthExpired) _Refresh?.Stop();
                _Error = result.Outcome switch
                {
                    BrowserOutcome.Unauthenticated => "Session expired. Log in again to load runs.",
                    BrowserOutcome.Forbidden => "Access denied. Log in again.",
                    BrowserOutcome.RateLimited => "Too many requests. Wait a moment, then refresh.",
                    BrowserOutcome.Unavailable => "Dashboard unavailable. Try refreshing shortly.",
                    _ => "Could not load runs. Check your connection and refresh.",
                };
                _Announcement = _Error;
                StateHasChanged();
                return; // Atomic snapshot: a later-page failure must not discard loaded history.
            }
            latest = value;
            foreach (var item in value.Items) fresh[item.Run.RunId] = item;
            foreach (var warning in value.SourceWarnings) warnings.Add(warning);
            pages++;
            if (!value.HasMore) break;
        }
        if (latest is not null)
        {
            // Retain every loaded identity, updating it when present. Bound new identities without
            // silently deleting loaded history when offsets shift underneath a timer refresh.
            var merged = _ReplaceHistoryOnLoad ? new Dictionary<Guid, RunWorklistItem>() : _Items.ToDictionary(i => i.Run.RunId);
            _RetainedHistory = merged.Keys.Any(id => !fresh.ContainsKey(id));
            _ReplaceHistoryOnLoad = false;
            foreach (var item in fresh.Values)
                if (merged.ContainsKey(item.Run.RunId) || merged.Count < MaxItems) merged[item.Run.RunId] = item;
            _Items = merged.Values.ToArray();
            _Data = latest with { SourceWarnings = warnings.ToArray() };
            _PageCount = Math.Max(_PageCount, pages);
            _RequestedPages = _PageCount;
            _HasMore = latest.HasMore;
            _LastSuccess = Clock.GetUtcNow();
            _Error = null;
            _Announcement = $"Runs updated. {_Items.Count} loaded.";
        }
        _Loading = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _Disposed = true;
        if (_Refresh is not null) await _Refresh.DisposeAsync();
    }
}

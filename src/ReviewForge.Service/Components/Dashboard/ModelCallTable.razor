@using ReviewForge.Core.Domain
@using ReviewForge.Core.Ports
@using ReviewForge.Core.Profiling
@using System.Globalization
@implements IDisposable
@inject DashboardBrowserClient Browser

<section aria-label="Model-call profiling" class="model-call-section">
    <h3>Post-run profiler</h3>
    @if (Status.State is RunState.Queued or RunState.Running)
    {
        <p>Detailed model calls are available after execution ends. Live stage progress remains above.</p>
    }
    else if (Status.State == RunState.Skipped)
    {
        <p>Skipped runs do not retain model-call profiles.</p>
    }
    else
    {
        <p class="worklist-muted">Provider calls, application attempts and tools are counted separately. SDK-internal retries are unavailable. Missing usage is not zero. No prompts, responses or tool content are retained. Durations can overlap; parent and child durations are not additive.</p>
        <button type="button" disabled="@_Loading" @onclick="() => LoadAsync(0)">@(_Loading ? "Loading model calls…" : _Page is null ? "Load model calls" : "Reload first page")</button>
        @if (_Message is not null) { <p role="status">@_Message</p> }
        @if (_Page is { } page)
        {
            <p role="status">@StateLabel(page.State)</p>
            <p>Profile ID: <code>@(page.ProfileId?.ToString() ?? "unavailable")</code> · Whole-run provider calls: @(page.ObservedCalls.ToString(CultureInfo.InvariantCulture))</p>
            @if (page.Truncated) { <p>Detail cap reached. Observed count includes calls omitted from the table. The cap is shared by model, logical-call, attempt and tool rows.</p> }
            @if (page.Incomplete) { <p>Capture is incomplete or interrupted. Missing calls cannot be reconstructed. All retained measurements describe only observed capture, not full execution.</p> }
            <ProfileSummaries Page="page" StageSelected="StageSelected" />
            <p class="worklist-muted">Page starts after sequence @_After. No page counts are whole-run totals. Earlier pages are read again on explicit navigation, not accumulated in memory.</p>
            <ProfileExplorer @key="Status.RunId" Page="page" PageCursor="_After" StageFilter="@StageFilter" StageFilterVersion="StageFilterVersion" StageSelected="StageSelected" />
            <div class="execution-toolbar" aria-label="Profile paging">
                <button type="button" disabled="@(_Loading || _Cursors.Count == 0)" @onclick="PreviousAsync">Previous profile page</button>
                @if (page.NextSequence is { } next && next > _After)
                { <button type="button" disabled="@_Loading" @onclick="() => LoadAsync(next)">Next model calls</button> }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public RunStatus Status { get; set; } = default!;
    [Parameter] public string? StageFilter { get; set; }
    [Parameter] public long StageFilterVersion { get; set; }
    [Parameter] public EventCallback<string> StageSelected { get; set; }
    private Guid _RunId;
    private long _Generation, _After;
    private readonly List<long> _Cursors = [];
    private CancellationTokenSource _Cancellation = new();
    private ModelProfilePage? _Page;
    private string? _Message;
    private bool _Loading, _Disposed;
    protected override void OnParametersSet()
    {
        if (_RunId == Status.RunId) return;
        _Cancellation.Cancel(); _Cancellation.Dispose(); _Cancellation = new();
        _RunId = Status.RunId; _Generation++; _Page = null; _Message = null; _Loading = false;
        _After = 0; _Cursors.Clear();
    }
    private Task PreviousAsync() => _Cursors.Count == 0 ? Task.CompletedTask : LoadAsync(_Cursors[^1], true);
    private async Task LoadAsync(long after, bool previous = false)
    {
        if (_Loading || _Disposed || Status.State is RunState.Queued or RunState.Running or RunState.Skipped) return;
        _Loading = true; _Message = null;
        var generation = _Generation;
        var result = await Browser.GetModelCallsAsync(_RunId, after, ProfileExplorerPresentation.PageSize, _Cancellation.Token);
        if (_Disposed || generation != _Generation) return;
        _Loading = false;
        if (result.Outcome == BrowserOutcome.Ok)
        {
            if (after == 0) _Cursors.Clear();
            else if (previous) _Cursors.RemoveAt(_Cursors.Count - 1);
            else if (after > _After && _Cursors.Count < 10_000) _Cursors.Add(_After);
            _After = after; _Page = result.Value;
        }
        else if (result.Outcome != BrowserOutcome.Cancelled)
        {
            _Message = result.Outcome == BrowserOutcome.Unauthenticated ? "Session expired. Sign in to read model calls."
                : "Could not read model calls. Use Load model calls or Reload first page to retry. Any visible page and summaries are from the last successful read.";
        }
    }
    private static string StateLabel(string state) => state switch {
        "empty" => "No model calls were observed in this run.",
        "legacy-unavailable" => "Detailed profiling is unavailable for this legacy run.",
        "expired" => "Detailed model calls expired. Available aggregate summaries are retained.",
        "incomplete" => "Incomplete model-call capture.",
        "truncated" => "Truncated model-call capture.",
        "not-yet-available" => "Detailed model calls are not yet available.",
        "skipped-not-recorded" => "Skipped runs do not retain model-call profiles.",
        _ => "Recorded model calls." };
    public void Dispose()
    {
        _Disposed = true; _Cancellation.Cancel(); _Cancellation.Dispose();
    }
}

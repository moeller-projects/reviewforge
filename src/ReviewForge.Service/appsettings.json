{
  "Ado": {
    "OrgUrl": "https://dev.azure.com/aveato",
    "Project": "Laekker.Kitchen"
  },
  "Reasoning": {
    "Provider": "openai-codex",
    "Model": "openai-codex:gpt-5.6-luna"
  },
  "ReviewForge": {
    "WorkDir": "D://tmp/wd",
    "StoreConnectionString": "Data Source=D://tmp/reviewforge.db",

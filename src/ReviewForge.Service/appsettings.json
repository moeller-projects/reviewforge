      "Enabled": true,
      "MaxAge": "3.00:00:00",
      "MaxCheckoutsPerRepo": 10,
      "SweepInterval": "01:00:00"
    },
    "ReasoningEffort": null,
    "RuleSetsPath": null
  },
  "ApiDocs": {
    "Enabled": false
  },
  "Discovery": {
    "TargetBranches": [
      "main",
      "master",
      "dev",
      "develop",
      "SystemService"
    ],
    "Creators": [],
    "MaxEnqueuesPerSweep": 20,
    "SweepInterval": "00:30:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Urls": "http://localhost:5080"
}

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ReviewForge.Core.Tests"/>
        <InternalsVisibleTo Include="ReviewForge.Service.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Reasoning/Prompts/pr-review-agent.md" LogicalName="ReviewForge.Core.Reasoning.Prompts.pr-review-agent.md"/>
        <EmbeddedResource Include="Reasoning/Prompts/author-commanded-fix-agent.md" LogicalName="ReviewForge.Core.Reasoning.Prompts.author-commanded-fix-agent.md"/>
        <EmbeddedResource Include="Reasoning/Prompts/resolve-comment-triage-agent.md" LogicalName="ReviewForge.Core.Reasoning.Prompts.resolve-comment-triage-agent.md"/>
        <EmbeddedResource Include="Reasoning/Rules/*.json" LogicalName="ReviewForge.Core.Reasoning.Rules.%(Filename).json"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Agents.AI"/>
        <PackageReference Include="Microsoft.Extensions.AI"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>

</Project>

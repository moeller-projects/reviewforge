<Project Sdk="Aspire.AppHost.Sdk/17.0.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AspireUseCliBundle>true</AspireUseCliBundle>
        <UserSecretsId>5dfceffa-8ffd-439e-8eae-0b778e8b63c5</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Keeps the service in the AppHost build dependency graph. -->
        <ProjectReference Include="../ReviewForge.Service/ReviewForge.Service.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.Dotnet" />
    </ItemGroup>

</Project>

# ReviewForge configuration template.
#
# This file is not loaded automatically. Source it before running locally,
# or pass it to run.ps1 with -EnvFile so the values reach the container.
# Explicit script parameters override environment values; environment values
# override the defaults in the Python package.
#
# Values marked "unset" are intentionally commented out. Leaving them unset
# preserves the package default and avoids forcing a host-specific path.

# ---------------------------------------------------------------------------
# Azure DevOps target
# ---------------------------------------------------------------------------
# Wrapper settings for run-open-prs.ps1.
ADO_ORGANIZATION=https://dev.azure.com/<your-org>/
ADO_PROJECTS=<proj1>,<proj2>
ADO_TARGET_BRANCHES=main,master,develop,dev

# Per-PR identity. PR_URL can provide org/project/repository/PR identity.
PR_URL=
ADO_ORG=
ADO_PROJECT=
ADO_REPO_ID=
PR_ID=
SOURCE_BRANCH=
TARGET_BRANCH=

# Safe ADO request retry policy.
ADO_RETRY_ATTEMPTS=3
ADO_RETRY_BASE_DELAY=1
ADO_RETRY_CAP_DELAY=30
ADO_RETRY_BUDGET_SECS=90

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Set one supported ADO token alias. SYSTEM_ACCESSTOKEN is the Azure
# Pipelines alias; AZURE_DEVOPS_EXT_PAT is retained for Git askpass callers.
SYSTEM_ACCESSTOKEN=
ADO_AUTH_TOKEN=
ADO_MCP_AUTH_TOKEN=
ADO_API_KEY=
AZURE_DEVOPS_EXT_PAT=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Model and review behavior
# ---------------------------------------------------------------------------
MODEL_BACKEND=pi
PI_MODEL=openai/gpt-5.5
PI_THINKING=medium
REVIEW_LANGUAGE=English
MAX_DIFF_BYTES=200000
CHUNK_TRIGGER_DIFF_BYTES=200000
DISABLE_CHUNK_REVIEW=0
PI_TIMEOUT_SECS=600
PI_RETRY_ATTEMPTS=2
PI_RETRY_BASE_DELAY=5
PI_RETRY_CAP_DELAY=60
COMMIT_CONTEXT_MAX=50
ANCHOR_POLICY=downgrade
INCLUDE_WORK_ITEMS=1
INCLUDE_EXISTING_COMMENTS=1
VERIFY_FINDINGS=1
FORCE_REVIEW=0
FORCE_FULL_REVIEW=0
DRY_RUN=0
REPLY_COMMENTS=1
REVIEW_TARGET_BRANCHES=

# ---------------------------------------------------------------------------
# Posting and context policy
# ---------------------------------------------------------------------------
POST_MIN_SEVERITY=none
DROP_LOW_CONFIDENCE=0
REQUIRE_CONTEXT_FOR=
MAX_FINDINGS=
VOTE_WAITING_ON=none
FAIL_ON=none
ANNOTATE_STALE=1
REVIEW_SCOPE_WORKERS=8
CONTEXT_FILE_MAX_LINES=260
CONTEXT_SEARCH_MAX_MATCHES=40
COLLECT_CONTEXT_WORKERS=8
AC_COVERAGE_LLM=0
AC_COVERAGE_LLM_MAX_ACS=10
AC_COVERAGE_CHECK=1
AC_COVERAGE_DRY_RUN=1

# ---------------------------------------------------------------------------
# Paths and run identity
# ---------------------------------------------------------------------------
WORKSPACE=/workspace
CLONE_ROOT=/workspace/repo
REVIEW_ARTIFACT_ROOT=/workspace/artifacts
# REVIEW_ARTIFACT_DIR=unset
# REVIEW_RUN_ID=unset
#
# Prompt and standards paths are optional. Unset uses the package defaults
# (/app/prompts and /app/standards in the container).
# REVIEW_PROMPT_PATH=unset
# INTENT_PROMPT_PATH=unset
# CONTEXT_PLAN_PROMPT_PATH=unset
# CONTEXT_DIGEST_PROMPT_PATH=unset
# VERIFY_PROMPT_PATH=unset
# SEVERITY_PROMPT_PATH=unset
# REVIEW_STANDARDS_PATH=unset
# AC_COVERAGE_PROMPT_PATH=unset
# FAST_REVIEW_PROMPT_PATH=unset
# CHUNK_SYNTHESIS_PROMPT_PATH=unset
# COMMENT_REPLY_PROMPT_PATH=unset
# COMMENT_TEMPLATE_PATH=unset

# ---------------------------------------------------------------------------
# Reasoning engine and Pi sessions
# ---------------------------------------------------------------------------
REASONING_ENGINE=single_pi
FAST_REVIEW=0
DEBUG_INTERMEDIATES=0
# PI_SESSION_ID=unset
PI_SESSION_ENABLED=1
PI_SESSION_CLEAR=0
ESCALATION_REVIEW_ENABLED=0
# ESCALATION_REVIEW_MODEL=unset  # defaults to PI_MODEL
REVIEW_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional CRG enrichment
# ---------------------------------------------------------------------------
CRG_ENABLED=0
# CRG_CACHE_DIR=unset  # ops defaults to /workspace/crg-cache in the container
CRG_CONTEXT_MAX_BYTES=8192
GRAPH_API_DIFF=0
GRAPH_FLOWS=0
GRAPH_ARCH=0
GRAPH_CONTEXT_MAX_BYTES=12288

# ---------------------------------------------------------------------------
# Host/build/wrapper settings
# ---------------------------------------------------------------------------
IMAGE_NAME=reviewforge:latest
# IMAGE=unset  # compatibility alias for IMAGE_NAME
PI_VERSION=0.80.7
UV_VERSION=0.11.28
# PI_AUTH_JSON_PATH=unset  # defaults to ~/.pi/agent/auth.json on the host
# DOCKER_BUILDKIT=unset    # Docker must use BuildKit; setting 0 is rejected
CONTAINER_NAME=
ARTIFACT_PATH=
REVIEW_ARTIFACT_VOLUME_NAME=reviewforge-artifacts
REVIEW_CRG_CACHE_VOLUME_NAME=reviewforge-crg-cache

# Dockerfile-internal values are set by the image and normally need no
# override: PI_SKIP_VERSION_CHECK, PI_TELEMETRY, PYTHONUNBUFFERED.
